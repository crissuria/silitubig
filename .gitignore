*.jks
*.p12
*.mobileprovision

# Secrets / local env files
.env
.env.*
*.pem
*.key

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Export builds — distributed via GitHub Releases
/build/
